<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="XMP Core 6.0.0">
	<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
		<rdf:Description rdf:about=""
				xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
				xmlns:xmp="http://ns.adobe.com/xap/1.0/"
				xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
				xmlns:dc="http://purl.org/dc/elements/1.1/"
				xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/"
				xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#"
				xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#"
				xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/">
			<pdf:Producer>MicrosoftÂ® Word for Microsoft 365</pdf:Producer>
			<pdf:Keywords>Automated testing; end-to-end (E2E); Humanâ€“Machine Interface; Play-wright; CI/CD; Docker; safety-critical systems; HMI testing.</pdf:Keywords>
			<xmp:CreatorTool>MicrosoftÂ® Word for Microsoft 365</xmp:CreatorTool>
			<xmp:CreateDate>2025-06-18T18:35:30+03:00</xmp:CreateDate>
			<xmp:ModifyDate>2025-06-18T18:44:29+03:00</xmp:ModifyDate>
			<xmpMM:DocumentID>uuid:65194035-57EE-442C-A644-B3AA936FA129</xmpMM:DocumentID>
			<xmpMM:InstanceID>uuid:65194035-57EE-442C-A644-B3AA936FA129</xmpMM:InstanceID>
			<dc:title>
				<rdf:Alt>
					<rdf:li xml:lang="x-default">Automated web-based testing frame-work for the interface of a power plant control</rdf:li>
				</rdf:Alt>
			</dc:title>
			<dc:creator>
				<rdf:Seq>
					<rdf:li>Duong Truong</rdf:li>
				</rdf:Seq>
			</dc:creator>
			<dc:description>
				<rdf:Alt>
					<rdf:li xml:lang="x-default">Humanâ€“Machine Interfaces (HMIs) in factory control rooms demand the highest levels of reliability and safety. Traditional manual testing of web-based HMIs is labour-intensive, prone to human mistake, and una-ble to keep pace with modern agile workflows. This thesis presents the design, implementation, and evaluation of an end-to-end automated testing framework for web-based HMI. Leveraging Playwright for reliable browser automation, Docker for environment consistency, and Bam-boo/Bitbucket for continuous integration and continuous development, the framework embeds automated tests directly into the pull-request workflow to provide immediate feedback on every commit.</rdf:li>
				</rdf:Alt>
			</dc:description>
			<pdfaExtension:schemas>
				<rdf:Bag>
					<rdf:li rdf:parseType="Resource">
						<pdfaSchema:namespaceURI>http://ns.adobe.com/pdf/1.3/</pdfaSchema:namespaceURI>

%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial", "primaryTextColor": "#1F2937", "lineColor": "#64748B"}}}%%
flowchart TB
    classDef manual fill:#F8FAFC,stroke:#64748B,color:#1F2937
    classDef ui fill:#DBEAFE,stroke:#60A5FA,color:#1F2937
    classDef api fill:#DCFCE7,stroke:#4ADE80,color:#1F2937
    classDef core fill:#F1F5F9,stroke:#64748B,color:#1F2937
    classDef data fill:#FEF3C7,stroke:#F59E0B,color:#1F2937
    classDef reporting fill:#F3E8FF,stroke:#A78BFA,color:#1F2937
    classDef risk fill:#FFE4E6,stroke:#FB7185,color:#1F2937

    subgraph HUMAN["Human-led testing"]
        M["Manual exploratory testing<br/>judgement, usability, unknown risks"]
    end

    subgraph AUTO["Automated regression layers"]
        U["E2E UI automation<br/>critical user journeys"]
        A["API/service automation<br/>endpoint behavior + contracts"]
        C["Unit/component checks<br/>small isolated logic"]
    end

    subgraph PROJECT["Project application"]
        P["Combined UI + API framework<br/>selected Unsplash flows"]
        D["Reusable test data + DTOs<br/>repeatable inputs"]
        R["Reports and traces<br/>debugging evidence"]
        B["Evidence boundary<br/>pass rate requires execution"]
    end

    Q1["High business confidence<br/>higher maintenance cost"]
    Q2["Faster service feedback<br/>less browser dependency"]
    Q3["Broad low-level feedback<br/>lowest execution cost"]

    M -->|guides risk focus| U
    U -->|fewer, critical scenarios| A
    A -->|supports contracts| C
    U -. quality trade-off .-> Q1
    A -. quality trade-off .-> Q2
    C -. quality trade-off .-> Q3
    U -->|validates visible flows| P
    A -->|validates public endpoints| P
    D -->|feeds| P
    P -->|produces| R
    R -. constrained by .-> B

    class M manual
    class U,Q1 ui
    class A,Q2,P api
    class C,Q3 core
    class D data
    class R reporting
    class B risk

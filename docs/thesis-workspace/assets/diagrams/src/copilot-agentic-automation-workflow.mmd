flowchart LR
    Need["Testing need<br/>or user request"]
    Context["Repository context<br/>docs and framework"]
    Guidance["Copilot guidance<br/>instructions and agents"]
    Design["Test-case design"]
    Generate["Playwright script<br/>generation"]
    Review["Automation code<br/>review"]
    Output["Framework-compliant<br/>automation output"]
    MCP["Optional Playwright MCP<br/>UI inspection"]

    Need --> Context
    Context --> Guidance
    Guidance --> Design
    Design --> Generate
    Generate --> Review
    Review --> Output

    Context -. reuse first .-> Generate
    MCP -. informs UI scripts .-> Generate
    Review -. feedback .-> Generate

    classDef entry fill:#F8FAFC,stroke:#94A3B8,color:#1F2937
    classDef context fill:#F1F5F9,stroke:#64748B,color:#1F2937
    classDef agentic fill:#E0E7FF,stroke:#818CF8,color:#1F2937
    classDef review fill:#F3E8FF,stroke:#A78BFA,color:#1F2937
    classDef ui fill:#DBEAFE,stroke:#60A5FA,color:#1F2937
    classDef core fill:#DCFCE7,stroke:#4ADE80,color:#1F2937

    class Need entry
    class Context context
    class Guidance,Design,Generate agentic
    class Review review
    class Output core
    class MCP ui

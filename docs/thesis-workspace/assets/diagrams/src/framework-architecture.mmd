%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryTextColor": "#1F2937", "lineColor": "#64748B", "clusterBkg": "#FFFFFF", "clusterBorder": "#CBD5E1"}}}%%
flowchart TB
    subgraph L1["Test specification layer"]
        direction LR
        UITests["<b>UI test specs</b><br/><i>tests/ui</i>"]
        APITests["<b>API test specs</b><br/><i>tests/api</i>"]
    end

    subgraph L2["Abstraction layer"]
        direction LR
        POM["<b>Page Objects &amp; workflows</b><br/><i>page-object, workflow</i>"]
        APISvc["<b>API services</b><br/><i>api-service</i>"]
    end

    subgraph L3["Framework core layer"]
        direction LR
        Fixtures["<b>Fixtures</b><br/><i>fixtures, core/fixtures</i>"]
        CoreUtil["<b>Core utilities</b><br/><i>core, utils</i>"]
    end

    Data["<b>Data and configuration</b><br/><i>data-object, constants, test-data, config</i>"]
    Report["<b>Reporting and evidence</b><br/><i>HTML, JUnit, traces</i>"]
    SUT["<b>System under test</b><br/><i>Unsplash UI and public API</i>"]

    UITests --> POM
    APITests --> APISvc
    POM --> Fixtures
    APISvc --> CoreUtil
    Fixtures --> SUT
    CoreUtil --> SUT
    Data -. supports .-> UITests
    Data -. supports .-> APITests
    UITests --> Report
    APITests --> Report
    CoreUtil --> Report

    classDef entry fill:#F8FAFC,stroke:#94A3B8,color:#1F2937
    classDef ui fill:#DBEAFE,stroke:#60A5FA,color:#1F2937
    classDef api fill:#DCFCE7,stroke:#4ADE80,color:#1F2937
    classDef core fill:#F1F5F9,stroke:#64748B,color:#1F2937
    classDef data fill:#FEF3C7,stroke:#F59E0B,color:#1F2937
    classDef report fill:#F3E8FF,stroke:#A78BFA,color:#1F2937
    classDef context fill:#FFFFFF,stroke:#94A3B8,color:#1F2937

    class UITests entry
    class APITests entry
    class POM ui
    class APISvc api
    class Fixtures core
    class CoreUtil core
    class Data data
    class Report report
    class SUT context

%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial", "primaryTextColor": "#1F2937", "lineColor": "#64748B"}}}%%
flowchart TB
    classDef test fill:#F1F5F9,stroke:#64748B,color:#1F2937
    classDef pom fill:#DBEAFE,stroke:#60A5FA,color:#1F2937
    classDef core fill:#F8FAFC,stroke:#64748B,color:#1F2937
    classDef browser fill:#DCFCE7,stroke:#4ADE80,color:#1F2937
    classDef data fill:#FEF3C7,stroke:#F59E0B,color:#1F2937
    classDef reporting fill:#F3E8FF,stroke:#A78BFA,color:#1F2937

    G["Test intent<br/>user-visible behavior"]
    T["Test specification<br/>steps + assertions"]
    P["Page Object<br/>page API methods"]
    A["Action method<br/>click, fill, verify"]
    L["Locator strategy<br/>role, text, test id"]
    B["Playwright page<br/>browser + DOM"]
    R["Assertion result<br/>observable outcome"]

    G -->|expressed as| T
    T -->|calls| P
    P -->|exposes| A
    A -->|uses| L
    L -->|resolved by| B
    B -->|observed through| R
    R -->|checked by| T

    class G data
    class T test
    class P,A pom
    class L core
    class B browser
    class R reporting
